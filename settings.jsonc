{
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 14.0,
  "buffer_font_size": 15.0,
  "cursor_shape": "bar",
  "cursor_blink": false,
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
  },
  "scrollbar": { "show": "never" },
  "status_bar": {
    "show": true,
  },
  "vertical_scroll_margin": 8,
  "colorize_brackets": false,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "relative_line_numbers": "enabled",
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "terminal": {
    "font_size": 14.0,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark",
  },
  "debugger": {
    "dock": "bottom",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": { "enabled": false, "show_value_hints": false },
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff"],
    },
  },
  "lsp": {
    "basedpyright": {
      "binary": { "allow_binary_download": true },
    },
    "ruff": {
      "binary": { "allow_binary_download": true },
    },
    "ty": {
      "binary": { "allow_binary_download": true },
    },
    "json-language-server": {
      "binary": { "allow_binary_download": true },
    },
  },
  "dap": {
    "Debugpy": {
      "binary": ".venv/Lib/site-packages/debugpy/adapter",
      "allow_binary_download": false,
    },
  },
  "node": {
    "allow_binary_download": true,
    "allow_npm_install": true,
    "allow_prettier_download": true,
  },
}
